# Groq API key — required for LLM-powered narration, copilot answers, and
# refined risk-factor extraction. The app runs without it, falling back to
# deterministic rule-based reasoning (clearly labeled in the UI as "LLM offline").
GROQ_API_KEY=

# Optional — defaults to llama-3.3-70b-versatile if not set.
GROQ_MODEL=llama-3.3-70b-versatile
